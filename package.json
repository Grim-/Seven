    "diff": "^9.0.0",
    "dnd-data": "^1.0.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.50.0",
    "mammoth": "1.12.3",
    "mermaid": "^12.1.0",
    "minisearch": "^7.2.0",
    "motion": "^14.0.0",
    "openai": "^7.28.0",
    "react-grid-layout": "^2.2.4",
    "react-is": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.3",
    "read-excel-file": "9.3.10",
    "recharts": "^3.10.1",
