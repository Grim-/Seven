    "@electron-toolkit/utils": "^4.0.0",
    "@git-diff-view/react": "^0.1.7",
    "@huggingface/gguf": "^0.4.6",
    "node-forge": "^1.3.1",
    "bonjour-service": "^1.4.4",
    "pixi.js": "^8.22.0",
    "@milkdown/crepe": "^7.22.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@mozilla/readability": "^0.6.0",
    "@rowanmanning/feed-parser": "2.1.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
